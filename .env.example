# Copy to .env for local development with `netlify dev`, OR set these in the
# Netlify dashboard under Site settings → Environment variables.

# Required for the "Ask AI" assistant (kept secret server-side, never exposed):
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini:
# OPENAI_MODEL=gpt-4o-mini

# Optional — live product search on the Wishlist (RapidAPI "Real-Time Product
# Search"). Without it, paste-a-link auto-fill and AI features still work.
# RAPIDAPI_KEY=...
# RAPIDAPI_PRODUCT_HOST=real-time-product-search.p.rapidapi.com
