# Copy to .env for local development with `netlify dev`, OR set these in the
# Netlify dashboard under Site settings → Environment variables.
# The app runs fully offline without any of these — add them when you connect
# a service (see Settings → Integrations in the app).

# Optional — cloud transcription & AI summaries for the Journal
# (kept secret server-side, never exposed to the browser):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional — Google Calendar two-way sync:
# GOOGLE_CLIENT_ID=...

# Optional — Plaid for live bank balances:
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...

# Optional — web push reminders to your phone:
# VAPID_PUBLIC_KEY=...

# Optional — the Bot API (netlify/functions/bot.ts) your AI bots call.
# See docs/BOT_API.md. Server-side only: NEVER prefix these with VITE_.
# BOT_API_KEY=...                 # openssl rand -hex 32
# SUPABASE_SERVICE_ROLE_KEY=...   # Supabase secret / service_role key
# BOT_USER_ID=...                 # your Supabase user id (Authentication → Users)
# SUPABASE_URL=...                # optional; defaults to VITE_SUPABASE_URL
# BOT_TIMEZONE=America/Chicago    # optional; what "today" means for bots
